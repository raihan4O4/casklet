{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casklet.local/schemas/inventory-v1.schema.json",
  "title": "Casklet inventory export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "cask",
    "categories",
    "resources",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "enum": ["portable", "machine"] },
    "cask": {
      "type": "object",
      "required": ["name", "state"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string", "maxLength": 500 },
        "state": { "type": "string" },
        "id": { "type": "string", "format": "uuid" },
        "managedStorageRoot": { "type": "string" }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "management",
          "containment",
          "availability",
          "categoryKey",
          "sizeBytes",
          "sizeMeasurement"
        ],
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["FILE", "DIRECTORY"] },
          "management": { "enum": ["MANAGED", "REFERENCED"] },
          "containment": { "enum": ["INTERNAL", "EXTERNAL"] },
          "availability": { "type": "string" },
          "categoryKey": { "type": "string" },
          "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
          "sizeMeasurement": { "type": "string" },
          "relativePath": { "type": "string" },
          "id": { "type": "string", "format": "uuid" },
          "path": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "const": "portable" } } },
      "then": {
        "properties": {
          "cask": { "not": { "required": ["id"] } },
          "resources": {
            "items": {
              "not": {
                "anyOf": [{ "required": ["id"] }, { "required": ["path"] }]
              }
            }
          }
        }
      }
    }
  ]
}
