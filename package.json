{
  "name": "casklet",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "check": "corepack pnpm --filter @casklet/desktop check",
    "lint": "corepack pnpm --filter @casklet/desktop lint",
    "build": "corepack pnpm --filter @casklet/desktop build",
    "test": "corepack pnpm --filter @casklet/desktop test",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0"
  }
}
