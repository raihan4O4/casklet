{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Casklet",
  "version": "0.0.0",
  "identifier": "app.casklet.dev",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    },
    "windows": [{ "title": "Casklet", "width": 960, "height": 640 }]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
