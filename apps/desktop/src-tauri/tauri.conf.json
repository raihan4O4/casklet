{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Casklet",
  "version": "0.1.0-alpha.1",
  "identifier": "app.casklet.dev",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Casklet",
        "width": 1024,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#ffffff"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../NOTICE": "NOTICE",
      "../../../LICENSES/Inter-OFL.txt": "licenses/Inter-OFL.txt",
      "../../../LICENSES/Lucide-ISC.txt": "licenses/Lucide-ISC.txt",
      "../../../LICENSES/README.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
